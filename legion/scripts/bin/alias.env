# shellcheck shell=bash
# =============================================================================
# alias.env - `llm` command for the shared llama.cpp builds (Legion 7a, AI Max+ 388)
# Sourced from each user's ~/.bashrc by llama-setup.sh.
#
#   llm                      show help + model keys
#   llm <key>                start server + web UI (ROCm, 0.0.0.0:9874)
#   llm <key> -d             start in background (log + pid in $LLM_ROOT/run)
#   llm <key> -b vulkan      start with the Vulkan build
#   llm <key> --local        loopback only (127.0.0.1)
#   llm stop [key]           stop background server(s)
#   llm logs [key]           tail background server log
#   llm bench <key> [rocm|vulkan|both]
#   llm --recompile          git pull + rebuild llama.cpp
# =============================================================================
[ -n "${BASH_VERSION:-}" ] || { echo "alias.env requires bash" >&2; return 0; }


export LLM_ROOT="${LLM_ROOT:-/home/shared}"
export LLM_BIN_ROOT="$LLM_ROOT/bin"
export PATH="$LLM_ROOT/bin:$PATH"
export LLAMA_CACHE="${LLM_MODEL_DIR:-$LLM_ROOT/common/llama.cpp/models}"   # shared model download cache
LLM_SETUP="$LLM_BIN_ROOT/llama-setup.sh"
LLM_SLEEP_SECS="${LLM_SLEEP_SECS:-1800}"   # 0 = disabled
LLM_CACHE_RAM="${LLM_CACHE_RAM:-8192}"                    # prompt cache cap in MiB (0 = disable) 4096, 8192
LLM_ALIAS_FILE="${BASH_SOURCE[0]}"
LLM_DEFAULT_BACKEND="${LLM_DEFAULT_BACKEND:-rocm}"        # rocm | vulkan
LLM_PORT="${LLM_PORT:-9874}"                              # server + built-in web UI port
LLM_HOST="${LLM_HOST:-0.0.0.0}"                           # 0.0.0.0 = reachable from other machines; use --local for loopback only
[ -z "${LLM_API_KEY:-}" ] && [ -r "$LLM_ROOT/api.key" ] && LLM_API_KEY="$(head -n1 "$LLM_ROOT/api.key")"   # optional shared key file
LLM_UMA="${LLM_UMA:-1}"                                   # ROCm unified memory (use GTT beyond the BIOS VRAM carve-out)
LLM_RUN_DIR="${LLM_RUN_DIR:-$LLM_ROOT/run}"               # pid + log files for background servers (-d)

# =============================================================================
# MODEL REGISTRY  -  add / edit models here
#
#   llm_add <key> <source> "<description>" "<extra llama-server args>"
#
#   <source>  Hugging Face repo[:quant]   -> downloaded on first run into $LLAMA_CACHE
#             or an absolute path to a .gguf file
#   <extra>   appended after the defaults, so they override them (last flag wins)
#
# NOTE: entries marked "verify" are my best guess at the repo name; confirm on
#       huggingface.co (or point <source> at a local .gguf) before first use.
# =============================================================================
LLM_KEYS=()
declare -gA LLM_SRC=() LLM_DESC=() LLM_ARGS=()
llm_add() { LLM_KEYS+=("$1"); LLM_SRC[$1]="$2"; LLM_DESC[$1]="$3"; LLM_ARGS[$1]="${4:-}"; }

llm_add gpt-oss-20b   "ggml-org/gpt-oss-20b-GGUF"                      "OpenAI GPT-OSS 20B (MXFP4, MoE)" \
        "--temp 1.0 --top-p 1.0 --top-k 0 --repeat-penalty 1.0"
llm_add gemma4-26b    "ggml-org/gemma-4-26B-A4B-it-GGUF:Q4_0"           "Gemma 4 26B-A4B Q4_0 (MoE)  [verify repo]" \
        "--temp 1.0 --top-p 0.95 --top-k 64 --repeat-penalty 1.0"
llm_add qwen3.6-27b   "unsloth/Qwen3.6-27B-GGUF:Q4_K_M"                 "Qwen3.6 27B Q4_K_M (dense)  [verify repo]" \
        ""
llm_add qwen3-14b     "unsloth/Qwen3-14B-GGUF:Q4_K_M"                   "Qwen3 14B Q4_K_M (dense)" \
        "--temp 0.6 --top-p 0.95 --top-k 20 --min-p 0"
llm_add qwen3-coder   "unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q4_K_M" "Qwen3-Coder 30B-A3B Q4_K_M (MoE)" \
        ""
llm_add CaptainErisNebula-12b      "mradermacher/MN-CaptainErisNebula-12B-Chimera-v1.1-heretic-uncensored-abliterated-i1-GGUF:Q4_K_M"               "CaptainErisNebula" ""

# =============================================================================
# internals
# =============================================================================
_llm_help() {
  local k
  cat <<EOT
llm - run llama.cpp server on the shared builds (ROCm / Vulkan, gfx1151)

USAGE
  llm <model-key> [options] [-- extra llama-server args]
  llm <model-key> -d [options]        start in background
  llm stop [model-key]                stop background server(s)
  llm logs [model-key]                tail background server log
  llm bench <model-key> [rocm|vulkan|both]
  llm --recompile [--rocm-only|--vulkan-only|--force]
  llm --help

OPTIONS
  -d, --detach                run in background (log + pid in $LLM_RUN_DIR)
  -b, --backend rocm|vulkan   backend build (default: $LLM_DEFAULT_BACKEND)
  -p, --port N                port (default $LLM_PORT)
  -c, --ctx N                 context size (default 32768)
      --host ADDR             bind address (default $LLM_HOST)
      --local                 bind 127.0.0.1 only
      --remote                bind 0.0.0.0 (default)
      --api-key KEY           require API key (or export LLM_API_KEY, or put it in $LLM_ROOT/api.key)
      --                      pass everything after it straight to llama-server

MODEL KEYS
EOT
  printf '  %-14s %-52s %s\n' "KEY" "SOURCE" "DESCRIPTION"
  for k in "${LLM_KEYS[@]}"; do
    printf '  %-14s %-52s %s\n' "$k" "${LLM_SRC[$k]}" "${LLM_DESC[$k]}"
  done
  cat <<EOT

EXAMPLES
  llm gpt-oss-20b
  llm qwen3-14b -b vulkan -c 16384
  llm gemma4-26b --api-key s3cret      # remote clients must send the key
  llm qwen3-14b --local
  llm qwen3-14b -d --api-key s3cret    # background server
  llm logs qwen3-14b                   # tail its log
  llm stop                             # stop all background servers
  llm qwen3-coder -- --temp 0.2
  llm bench gpt-oss-20b both

WEB UI: llama-server serves its own chat UI at http://<this-machine>:$LLM_PORT/
        and an OpenAI-compatible API at http://<this-machine>:$LLM_PORT/v1

ADD / EDIT MODELS:  edit $LLM_ALIAS_FILE  (llm_add lines), then: source $LLM_ALIAS_FILE
Models cache: $LLAMA_CACHE    Bench results: $LLM_ROOT/bench
Background runs: $LLM_RUN_DIR
EOT
}

_llm_backend_env() {
  case "$1" in
    rocm)
      export PATH="/opt/rocm/bin:$PATH"
      export LD_LIBRARY_PATH="/opt/rocm/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
      export ROCBLAS_USE_HIPBLASLT=1
      if [ "$LLM_UMA" = 1 ]; then export GGML_CUDA_ENABLE_UNIFIED_MEMORY=1; fi
      ;;
    vulkan)
      export AMD_VULKAN_ICD=RADV
      ;;
  esac
}

_llm_bin() {  # <backend> <tool>
  local b="$LLM_BIN_ROOT/build-$1/bin/$2"
  [ -x "$b" ] || { echo "llm: $b not found - run: $LLM_SETUP" >&2; return 1; }
  echo "$b"
}

_llm_model_file() {  # resolve a local .gguf for benchmarking
  local src="${LLM_SRC[$1]}" repo quant prefix f
  if [[ "$src" == /* ]]; then echo "$src"; return 0; fi
  repo="${src%%:*}"; quant=""; [[ "$src" == *:* ]] && quant="${src#*:}"
  prefix="${repo//\//_}"
  f="$(ls -1 "$LLAMA_CACHE"/${prefix}_*${quant}*.gguf 2>/dev/null | grep -vi mmproj | head -n1)"
  [ -n "$f" ] || { echo "llm: model not downloaded yet. Run 'llm $1' once (wait for download, then Ctrl-C) and retry." >&2; return 1; }
  echo "$f"
}

_llm_bench() {  # <key> [backend]
  local key="$1" which="${2:-both}" file b bin out
  file="$(_llm_model_file "$key")" || return 1
  mkdir -p "$LLM_ROOT/bench"
  local -a backends
  case "$which" in both) backends=(rocm vulkan) ;; rocm|vulkan) backends=("$which") ;; *) echo "llm: backend must be rocm|vulkan|both" >&2; return 1 ;; esac
  for b in "${backends[@]}"; do
    bin="$(_llm_bin "$b" llama-bench)" || continue
    out="$LLM_ROOT/bench/$(date +%Y%m%d-%H%M%S)_${key}_${b}.md"
    echo "=== $key on $b  ($file) ==="
    ( _llm_backend_env "$b"
      "$bin" -m "$file" -ngl 99 -fa 1 -ctk q8_0 -ctv q8_0 -b 1024 -ub 256 -t 8 -p 512 -n 128 -r 3 -o md ) | tee "$out"
  done
}

_llm_stop() {  # [key]
  local f pid n=0
  for f in "$LLM_RUN_DIR"/${1:-*}-*.pid; do
    [ -f "$f" ] || continue
    pid="$(cat "$f")"
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" && echo "llm: stopped $(basename "${f%.pid}") (pid $pid)"; n=$((n+1))
    fi
    rm -f "$f"
  done
  [ "$n" -gt 0 ] || echo "llm: no running background servers${1:+ for '$1'}"
}

_llm_logs() {  # [key]
  local f
  f="$(ls -1t "$LLM_RUN_DIR"/${1:-*}-*.log 2>/dev/null | head -n1)"
  [ -n "$f" ] || { echo "llm: no logs found" >&2; return 1; }
  echo ">> tailing $f (Ctrl-C to stop watching; server keeps running)"
  tail -n 50 -f "$f"
}

llm() {
  local sleep_secs="$LLM_SLEEP_SECS"
  local backend="$LLM_DEFAULT_BACKEND" host="$LLM_HOST" port="$LLM_PORT" ctx=32768 api_key="${LLM_API_KEY:-}" detach=0
  local -a pos=() passthru=()

  [ $# -eq 0 ] && { _llm_help; return 0; }
  while (($#)); do
    case "$1" in
      -h|--help|help|list|ls) _llm_help; return 0 ;;
      --recompile)  shift; "$LLM_SETUP" --recompile "$@"; return $? ;;
      -d|--detach)  detach=1 ;;
      -b|--backend) backend="$2"; shift ;;
      -p|--port)    port="$2"; shift ;;
      -c|--ctx)     ctx="$2"; shift ;;
      --host)       host="$2"; shift ;;
      --remote)     host="0.0.0.0" ;;
      --local)      host="127.0.0.1" ;;
      --api-key)    api_key="$2"; shift ;;
      --sleep)      sleep_secs="$2"; shift ;;
      --)           shift; passthru=("$@"); break ;;
      -*)           echo "llm: unknown option $1 (use '--' to pass flags to llama-server)" >&2; return 2 ;;
      *)            pos+=("$1") ;;
    esac
    shift
  done

  # bench subcommand
  if [ "${pos[0]:-}" = bench ]; then
    [ -n "${pos[1]:-}" ] && [ -n "${LLM_SRC[${pos[1]}]+x}" ] || { echo "llm: bench needs a valid model key" >&2; _llm_help; return 2; }
    _llm_bench "${pos[1]}" "${pos[2]:-both}"; return $?
  fi

  # background-server management
  if [ "${pos[0]:-}" = stop ]; then _llm_stop "${pos[1]:-}"; return $?; fi
  if [ "${pos[0]:-}" = logs ]; then _llm_logs "${pos[1]:-}"; return $?; fi

  local key="${pos[0]:-}"
  if [ -z "$key" ] || [ -z "${LLM_SRC[$key]+x}" ]; then
    [ -n "$key" ] && echo "llm: unknown model key '$key'" >&2
    _llm_help; return 2
  fi
  case "$backend" in rocm|vulkan) ;; *) echo "llm: backend must be rocm or vulkan" >&2; return 2 ;; esac

  local bin; bin="$(_llm_bin "$backend" llama-server)" || return 1

  local src="${LLM_SRC[$key]}"
  local -a model_args extra
  if [[ "$src" == /* ]]; then
    [ -f "$src" ] || { echo "llm: file not found: $src" >&2; return 1; }
    model_args=(--model "$src")
  else
    model_args=(-hf "$src")
  fi
  read -r -a extra <<<"${LLM_ARGS[$key]}"

  local -a cmd=("$bin" "${model_args[@]}"
    --alias "$key" --host "$host" --port "$port"
    --n-gpu-layers 99 --ctx-size "$ctx" --parallel 1
    --batch-size 1024 --ubatch-size 256
    --flash-attn on --cache-type-k q8_0 --cache-type-v q8_0
    --threads 8 --threads-batch 8 --jinja
    --temp 0.7 --top-p 0.8 --top-k 20 --repeat-penalty 1.05
    --cache-ram "$LLM_CACHE_RAM"
    "${extra[@]}" "${passthru[@]}")
  if [ -n "$api_key" ]; then cmd+=(--api-key "$api_key"); fi
  if [ "${sleep_secs:-0}" -gt 0 ]; then cmd+=(--sleep-idle-seconds "$sleep_secs"); fi

  echo ">> $key [$backend] listening on $host:$port  (model alias: $key)"
  if [ "$host" = "127.0.0.1" ] || [ "$host" = "localhost" ]; then
    echo ">> Web UI: http://127.0.0.1:$port/"
  else
    local ip
    for ip in $(hostname -I 2>/dev/null); do echo ">> Web UI: http://$ip:$port/   API: http://$ip:$port/v1"; done
    echo ">> hostname: http://$(hostname):$port/"
    if [ -z "$api_key" ]; then echo ">> WARNING: no API key set - anyone on the network can use this server (see --api-key)" >&2; fi
  fi

  if [ "$detach" = 1 ]; then
    mkdir -p "$LLM_RUN_DIR"
    local pidf="$LLM_RUN_DIR/$key-$port.pid" logf="$LLM_RUN_DIR/$key-$port.log"
    if [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then
      echo "llm: $key already running on port $port (pid $(cat "$pidf")). Use 'llm stop $key'." >&2
      return 1
    fi
    ( umask 002; _llm_backend_env "$backend"
      setsid nohup "${cmd[@]}" >"$logf" 2>&1 </dev/null &
      echo $! >"$pidf" )
    sleep 1
    if kill -0 "$(cat "$pidf")" 2>/dev/null; then
      echo ">> started in background (pid $(cat "$pidf"))"
      echo ">> log: $logf   (llm logs $key | llm stop $key)"
    else
      echo "llm: server exited immediately, see $logf" >&2
      rm -f "$pidf"; return 1
    fi
  else
    ( umask 002; _llm_backend_env "$backend"; exec "${cmd[@]}" )
  fi
}

# tab completion
complete -W "${LLM_KEYS[*]} bench stop logs list -d --detach --help --recompile --remote --local --backend --port --ctx --api-key" llm 2>/dev/null || true
